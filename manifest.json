{
  "manifest_version": 3,
  "name": "视频旋转 · Video Rotate",
  "version": "1.2.4",
  "description": "视频右上角的半透明按钮，每次点击顺时针旋转 90°。",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "rotate.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/rotate-16.png",
    "32": "icons/rotate-32.png",
    "48": "icons/rotate-48.png",
    "128": "icons/rotate-128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "显示 / 隐藏视频旋转控件",
    "default_icon": {
      "16": "icons/rotate-16.png",
      "32": "icons/rotate-32.png",
      "48": "icons/rotate-48.png",
      "128": "icons/rotate-128.png"
    }
  }
}
