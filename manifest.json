{
  "manifest_version": 3,
  "name": "视频旋转 · Video Rotate",
  "version": "1.1.0",
  "description": "视频右上角的半透明按钮，每次点击顺时针旋转 90°。",
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["rotate.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_idle"
  }]
}
